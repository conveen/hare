{
	"name": "Build Container",
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer"
            ]
        }
    },
    "containerEnv": {
        "RUSTFLAGGS": "--cfg tracing_unstable"
    },
    "image": "ghcr.io/conveen/hare:build",
    "initializeCommand": ["./run.sh", "build-base"],
	"remoteUser": "dev"
}